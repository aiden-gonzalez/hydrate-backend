# Copy to deploy/.env.prod and fill in. Never commit .env.prod.

# Public hostname pointing at this server (e.g. a free no-ip DDNS name)
DOMAIN=api.example.com

# Postgres (the db container is created with these on first start)
CLOUD_PG_DB=hydrate_db
CLOUD_PG_USER=hydrate_admin
CLOUD_PG_PASS=generate_a_long_random_password

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# AWS (pictures). Use an IAM user limited to the bucket + CloudFront invalidations, see deploy/README.md
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AWS_CLOUDFRONT_URL=
AWS_CLOUDFRONT_KEY_PAIR_ID=
# The private key on one line with \n for newlines, in double quotes
AWS_CLOUDFRONT_PRIVATE_KEY=

# Email (SMTP) for password reset codes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="hydRate <no-reply@example.com>"

# Backups (host directory, and how many days to keep)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
